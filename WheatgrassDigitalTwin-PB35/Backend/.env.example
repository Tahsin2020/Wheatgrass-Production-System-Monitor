# Home Assistant Configuration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_access_token_here

# Keycloak Authentication
KEYCLOAK_URL=http://keycloak-local:8080
KEYCLOAK_REALM=wheatgrass
KEYCLOAK_CLIENT_ID=wheatgrass-monitor
KEYCLOAK_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_PUBLIC_KEY=

# Server Configuration
PORT=3001
SESSION_SECRET=change_this_to_a_random_secret_key

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wheatgrass_monitor
DB_USER=postgres
DB_PASSWORD=postgres

# Home Assistant RTSP Video Stream Forwarding Configuration
RTSP_USER=pb_ece
RTSP_PASSWORD=pb_ece123
RTSP_STREAM_URL=192.168.100.101:554/stream2
RTSP_WS_PORT=9999

# Entity IDs
TEMP_ENTITY_ID = sensor.wheatgrass_sensors_temperature
HUMIDITY_ENTITY_ID = sensor.wheatgrass_sensors_humidity
LIGHT_ENTITY_ID = sensor.wheatgrass_sensors_light
PRESSURE_ENTITY_ID = sensor.wheatgrass_sensors_pressure
WATER_FLOW_ENTITY_ID = sensor.wheatgrass_sensors_water_flow_rate

# Threshold Configuration (Optional - defaults provided)
# Temperature thresholds (°C)
TEMP_MIN=18
TEMP_MAX=28
TEMP_CRITICAL_MIN=15
TEMP_CRITICAL_MAX=32

# Humidity thresholds (%)
HUMIDITY_MIN=50
HUMIDITY_MAX=75
HUMIDITY_CRITICAL_MIN=40
HUMIDITY_CRITICAL_MAX=85

# Light thresholds (lux)
LIGHT_MIN=600
LIGHT_MAX=1200
LIGHT_CRITICAL_MIN=400
LIGHT_CRITICAL_MAX=1500

# Pressure thresholds (hPa)
PRESSURE_MIN=500
PRESSURE_MAX=10000
PRESSURE_CRITICAL_MIN=1000
PRESSURE_CRITICAL_MAX=9000

# Water Flow thresholds (L/min)
WATER_FLOW_MIN=0.5
WATER_FLOW_MAX=2.0
WATER_FLOW_CRITICAL_MIN=0.1
WATER_FLOW_CRITICAL_MAX=3.0
